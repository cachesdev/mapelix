{
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["build/**", ".svelte-kit/**", "!.svelte-kit/cache/**"],
      "env": [
        "MAPELIX_CACHE_DIRECTORY",
        "MAPELIX_RENDER_WORKERS",
        "MAPELIX_WORLD_DIRECTORY",
        "STRATOS_CACHE_DIRECTORY",
        "STRATOS_RENDER_WORKERS",
        "STRATOS_WORLD_DIRECTORY"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "MAPELIX_CACHE_DIRECTORY",
        "MAPELIX_RENDER_WORKERS",
        "MAPELIX_WORLD_DIRECTORY",
        "STRATOS_CACHE_DIRECTORY",
        "STRATOS_RENDER_WORKERS",
        "STRATOS_WORLD_DIRECTORY"
      ]
    },
    "preview": {
      "cache": false,
      "persistent": true,
      "env": [
        "HOST",
        "MAPELIX_CACHE_DIRECTORY",
        "MAPELIX_RENDER_WORKERS",
        "MAPELIX_WORLD_DIRECTORY",
        "PORT",
        "STRATOS_CACHE_DIRECTORY",
        "STRATOS_RENDER_WORKERS",
        "STRATOS_WORLD_DIRECTORY"
      ]
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false,
      "outputs": []
    }
  }
}
