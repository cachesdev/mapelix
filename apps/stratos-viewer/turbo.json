{
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["build/**", ".svelte-kit/**", "!.svelte-kit/cache/**"],
      "env": ["STRATOS_WORLD_DIRECTORY"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": ["STRATOS_WORLD_DIRECTORY"]
    },
    "preview": {
      "cache": false,
      "persistent": true,
      "env": ["HOST", "PORT", "STRATOS_WORLD_DIRECTORY"]
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false,
      "outputs": []
    }
  }
}
