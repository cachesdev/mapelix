{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": ["CI"],
  "tasks": {
    "benchmark": {
      "dependsOn": ["build"],
      "cache": false,
      "outputs": []
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "check": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "format": {
      "cache": false,
      "outputs": []
    },
    "format:check": {
      "outputs": []
    },
    "quality": {
      "dependsOn": ["check", "lint", "format:check", "test:unit"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "test:unit": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false,
      "outputs": []
    },
    "test:visual": {
      "dependsOn": ["build"],
      "cache": false,
      "outputs": [],
      "env": [
        "MAPELIX_VISUAL_CANDIDATES",
        "MAPELIX_VISUAL_OUTPUT",
        "MAPELIX_VISUAL_WORKERS",
        "MAPELIX_VISUAL_WORLD"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "preview": {
      "cache": false,
      "persistent": true
    }
  }
}
