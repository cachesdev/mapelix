{
  "extends": ["//"],
  "tasks": {
    "benchmark": {
      "dependsOn": ["build"],
      "cache": false,
      "outputs": [],
      "env": ["MAPELIX_BENCH_TILES", "MAPELIX_BENCH_WORKERS", "MAPELIX_BENCH_WORLD"]
    },
    "test:visual": {
      "dependsOn": ["build"],
      "cache": false,
      "outputs": [],
      "env": [
        "MAPELIX_VISUAL_CANDIDATES",
        "MAPELIX_VISUAL_OUTPUT",
        "MAPELIX_VISUAL_WORKERS",
        "MAPELIX_VISUAL_WORLD"
      ]
    },
    "build": {
      "outputs": ["dist/**"]
    }
  }
}
