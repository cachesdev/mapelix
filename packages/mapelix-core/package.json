{
  "name": "@mapelix/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    "./node/snapshot": {
      "types": "./dist/node/snapshot.d.ts",
      "import": "./dist/node/snapshot.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./appearance": {
      "types": "./dist/appearance/index.d.ts",
      "import": "./dist/appearance/index.js"
    },
    "./node/batch": {
      "types": "./dist/node/batch/index.d.ts",
      "import": "./dist/node/batch/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "check": "tsc --noEmit --project tsconfig.json",
    "lint": "oxlint --type-aware --type-check .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run src",
    "test:unit": "vitest run src",
    "quality": "pnpm run check && pnpm run lint && pnpm run format:check && pnpm run test:unit",
    "transit": "node -e \"\""
  },
  "dependencies": {
    "@mapelix/prototype": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.10.13",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2",
    "vitest": "4.1.0"
  },
  "engines": {
    "node": ">=24"
  }
}
